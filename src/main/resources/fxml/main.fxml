<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.uniquindio.permisosmunicipales.controller.MainController"
            stylesheets="@../css/styles.css">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 12 24; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
            </ImageView>
            <Label text="Planeación Municipal" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Pane prefWidth="20" />
            <Button fx:id="btnNavCiudadanos" text="Ciudadanos" styleClass="nav-button" onAction="#onSeleccionarCiudadanos" />
            <Button fx:id="btnNavPermisosRadicar" text="Permisos Radicados" styleClass="nav-button" onAction="#onSeleccionarPermisos" />
            <Button fx:id="btnNavPermisosListado" text="Permisos" styleClass="nav-button" onAction="#onSeleccionarListadoPermisos" />
        </HBox>
    </top>

    <center>
        <StackPane fx:id="areaContenido" />
    </center>
</BorderPane>